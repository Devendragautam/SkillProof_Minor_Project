{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "proctor service",
      "type": "shell",
      "command": "bun run dev",
      "options": { "cwd": "${workspaceFolder}/mini-services/proctor-service" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "bun run lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "bun run test",
      "problemMatcher": []
    },
    {
      "label": "db push + seed",
      "type": "shell",
      "command": "bun run db:push && bun run db:seed",
      "problemMatcher": []
    }
  ]
}
