generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Candidate {
  id          String       @id @default(cuid())
  name        String
  email       String?
  notes       String       @default("")
  tagsJson    String       @default("[]")
  archived    Boolean      @default(false)
  invited     Boolean      @default(false)
  /// Recruiter pipeline decision: "shortlisted" | "interview" | "offer" | "rejected" | null (no decision yet)
  pipelineStatus      String?
  /// Free-text rationale captured with the decision
  pipelineNote        String?
  /// Structured decision metadata as JSON: {scheduledAt?, panel?, comp?, startDate?}
  /// interview → scheduledAt/panel; offer → comp/startDate. Null when no metadata.
  pipelineMetaJson    String?
  pipelineUpdatedAt   DateTime?
  createdAt   DateTime     @default(now())
  resumes     Resume[]
  assessments Assessment[]
  /// Recruiter-issued skill certificates for completed assessments
  certificates Certificate[]
  /// Audit trail of pipeline decisions (status changes with notes + timestamps)
  pipelineEvents PipelineEvent[]

  @@index([email])
}

model Resume {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName    String
  rawText     String
  skillsJson  String
  createdAt   DateTime @default(now())

  @@index([candidateId, createdAt])
}

model Question {
  id                 String @id @default(cuid())
  externalId         String @unique
  skill              String
  category           String // coding | debugging | mcq
  topic              String
  difficulty         String // easy | medium | hard
  title              String
  description        String
  fnName             String?
  starterCode        String?
  testsJson          String? // [{args,expected,hidden}] — for SQL questions: [{setup?,expected(rows),hidden,unordered?}]
  optionsJson        String? // mcq options
  answerIndex        Int?
  explanation        String?
  hint               String?
  expectedComplexity String?
  schemaSql          String? // SQL questions: CREATE TABLE statements (its presence marks the question as SQL)
  seedSql            String? // SQL questions: INSERT seed data applied to every test run
  solutionSql        String? // SQL questions: reference solution (recruiter-facing, derives expected rows)
  timeLimitSec       Int     @default(900)
  points             Int     @default(10)
  source             String  @default("builtin") // builtin | imported | custom
  sourceUrl          String?
  createdAt          DateTime @default(now())
  assessmentQuestions AssessmentQuestion[]

  @@index([skill])
  @@index([category, difficulty])
}

model Assessment {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status       String    @default("in_progress") // in_progress | completed
  planJson     String    @default("{}")
  createdAt    DateTime  @default(now())
  /// Server-authoritative moment the run actually started (first question dealt).
  startedAt    DateTime?
  /// Optional server-side overall deadline. When set, every assessment mutation
  /// past this instant is rejected — the browser clock is never consulted.
  expiresAt    DateTime?
  completedAt  DateTime?
  questions    AssessmentQuestion[]
  report       Report?
  certificate  Certificate?

  @@index([candidateId, createdAt])
  @@index([status])
}

model AssessmentQuestion {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill         String
  order         Int
  status        String     @default("current") // current | solved | failed | skipped | timeout
  score         Float?
  timeSpentSec  Int?
  /// Effective time limit (seconds) snapshotted from the recruiter's timer
  /// policy at deal time — keeps scoring/analytics stable even if the policy
  /// changes mid-assessment. Null on legacy rows (falls back to Question).
  timeLimitSec  Int?
  /// Server-authoritative deal time — the instant this question became the
  /// active one. Elapsed time is ALWAYS derived from this column (plus
  /// deadlineAt); any browser-supplied timeSpentSec is ignored.
  dealtAt       DateTime?
  /// Server-authoritative deadline = dealtAt + timeLimitSec. Submissions past
  /// this instant (+ a small network grace window) are rejected and the
  /// question is finalized server-side as timeout.
  deadlineAt    DateTime?
  /// Single-active-question invariant: equals assessmentId exactly while
  /// status = "current", null otherwise. The @@unique below lets any number of
  /// NULL rows coexist (SQLite treats NULLs as distinct) but AT MOST ONE row
  /// per assessment can ever carry the active flag — two concurrent "deal
  /// next question" requests cannot both win.
  activeFlag    String?
  attempts      Int        @default(0)
  hintCount     Int        @default(0)
  createdAt     DateTime   @default(now())
  submission    Submission?

  @@unique([assessmentId, activeFlag])
  @@index([assessmentId, status])
  @@index([questionId])
}

model Submission {
  id                    String     @id @default(cuid())
  assessmentQuestionId  String     @unique
  assessmentQuestion    AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  code                  String
  language              String     @default("javascript")
  eventsJson            String     @default("[]")
  versionsJson          String     @default("[]")
  metricsJson           String     @default("{}")
  testResultsJson       String     @default("[]")
  passed                Boolean?
  runtimeMs             Float?
  explainQuestionsJson  String     @default("[]")
  analysisJson          String     @default("{}")
  aiRiskScore           Float?
  aiRiskSignalsJson     String     @default("[]")
  createdAt             DateTime   @default(now())
  explanationAnswers    ExplanationAnswer[]

  @@index([createdAt])
}

model ExplanationAnswer {
  id               String     @id @default(cuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionText     String
  answerText       String
  consistencyScore Float?
  aiFeedback       String?
  createdAt        DateTime   @default(now())

  @@index([submissionId])
}

model Report {
  id                  String     @id @default(cuid())
  assessmentId        String     @unique
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  overallScore        Float
  confidence          String     @default("MEDIUM")
  aiRiskScore         Float
  aiRiskConfidence    String     @default("MEDIUM")
  aiRiskSignalsJson   String     @default("[]")
  skillScoresJson     String     @default("[]")
  categoryScoresJson  String     @default("{}")
  breakdownJson       String     @default("[]")
  /// 192-bit cryptographically random secret for intentionally-shared public
  /// report links. NEVER the assessment id — knowing a run's id grants nothing.
  shareToken          String?    @unique
  createdAt           DateTime   @default(now())
}

/// Platform accounts — recruiters sign in to manage the pipeline & question bank,
/// candidates sign in so their verification attempts attach to a durable identity.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// scrypt hash in the form `salt:derivedKey` (both hex, N=16384)
  passwordHash String
  /// "recruiter" | "candidate"
  role         String
  createdAt    DateTime @default(now())
}

/// Recruiter-saved role-fit weight presets (server-side so they persist
/// across browsers/devices and can be shared by the recruiting team).
model FitPreset {
  id          String   @id @default(cuid())
  name        String   @unique
  weightsJson String
  createdAt   DateTime @default(now())
}

/// Audit trail for candidate pipeline decisions — every shortlist / interview /
/// rejection / clear is logged here with its note so the journey timeline can
/// show who-decided-what-when (single-team app, so no actor field for now).
model PipelineEvent {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// "shortlisted" | "interview" | "offer" | "rejected" | "cleared"
  status      String
  note        String?
  /// Immutable snapshot of the structured decision metadata at decision time (same shape as Candidate.pipelineMetaJson)
  metaJson    String?
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

/// Recruiter-configured per-question time limits for assessments (single row).
/// Times are section-wise: debugging in minutes, DSA/coding by difficulty in
/// minutes, MCQ in seconds. Applied by the assessment engine when a question
/// is dealt; the effective limit is snapshotted onto AssessmentQuestion.
model TimerPolicy {
  id           String   @id @default("default")
  /// Debugging questions — minutes per question
  debuggingMin Int      @default(5)
  /// Coding (DSA) questions, easy — minutes per question
  dsaEasyMin   Int      @default(20)
  /// Coding (DSA) questions, medium — minutes per question
  dsaMediumMin Int      @default(30)
  /// Coding (DSA) questions, hard — minutes per question
  dsaHardMin   Int      @default(45)
  /// MCQ questions — seconds per question
  mcqSec       Int      @default(45)
  /// Per-skill overrides as JSON: { "SQL": 15, "React": 25 } — minutes per
  /// question, replacing the section limit for every question of that skill
  /// (MCQ overrides round up to whole minutes). Empty object = section limits.
  skillOverridesJson String @default("{}")
  /// Proctor severity thresholds (live stream): a paste above pasteWarnChars
  /// is flagged warn, above pasteRiskChars is flagged risk; an explain-your-
  /// code consistency below explainWarnPct is flagged warn.
  pasteWarnChars Int @default(80)
  pasteRiskChars Int @default(200)
  explainWarnPct Int @default(70)
  updatedBy    String?
  updatedAt    DateTime @default(now()) @updatedAt
}

/// Recruiter-issued skill certificate for a completed assessment — a permanent,
/// publicly verifiable record with a human-readable lookup code (like a Tata
/// NQT scorecard). Skill percentages are snapshotted at issue time so the
/// certificate stays stable even if the underlying report is re-computed.
model Certificate {
  id            String     @id @default(cuid())
  /// Public verification code, e.g. "SP-7K3M-9QX2" (unambiguous alphabet)
  code          String     @unique
  candidateId   String
  candidate     Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// One certificate per assessment (idempotent issuing)
  assessmentId  String     @unique
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Snapshot [{name, score, level?}] — verified skill percentages
  scoresJson    String
  overallScore  Float
  /// Confidence recorded on the report at issue time (HIGH | MEDIUM | LOW)
  confidence    String     @default("MEDIUM")
  /// Recruiter display name captured at issue time
  issuedBy      String
  issuedAt      DateTime   @default(now())
  /// Frozen cohort standing at issue time — {size, rank, topPct, median,
  /// recordedAt}. Point-in-time evidence: the live standing moves as the
  /// cohort grows, this snapshot never does.
  cohortStandingJson String?

  @@index([candidateId])
  @@index([issuedAt])
}

/// Persisted live-proctoring event — the durable twin of the proctor
/// service's in-memory stream. The proctor service flushes events here
/// (fire-and-forget batches) so recruiters can review a session transcript
/// after the run ends; the live stream itself stays realtime-only.
model ProctorEventRecord {
  id            String   @id
  candidateId   String
  candidateName String
  assessmentId  String
  type          String
  detail        String
  /// info | good | warn | risk
  severity      String
  /// Wall-clock time of the event (epoch ms), set by the proctor service
  ts            DateTime
  createdAt     DateTime @default(now())

  @@index([assessmentId, ts])
  @@index([candidateId, ts])
}
