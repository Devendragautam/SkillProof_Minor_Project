# SkillProof — local environment template.
# Copy to .env and fill in real values:  cp .env.example .env

# SQLite database URL. Use an absolute path locally:
#   file:/home/you/skillproof/db/custom.db
# Relative paths resolve against prisma/schema.prisma, so from there:
#   file:../db/custom.db
# The db/ directory must exist before running prisma db push (it is gitignored).
DATABASE_URL=file:/home/you/skillproof/db/custom.db

# Recruiter account. There is no self-registration; the account is provisioned
# from these values by db:seed and on login. Quote values that contain #.
SKILLPROOF_RECRUITER_NAME="Devendra Gautam"
SKILLPROOF_RECRUITER_EMAIL=you@example.com
SKILLPROOF_RECRUITER_PASSWORD="use-a-strong-password"

# Demo candidate (optional). Created by:  DEMO_MODE=1 bun run db:seed:demo
DEMO_MODE=
SKILLPROOF_DEMO_CANDIDATE_PASSWORD=demo1234

# Session signing secret. OPTIONAL for local dev and single-container demo
# deploys: when unset, a cryptographically random secret is generated once and
# persisted to db/.session-secret (0600) — sessions stay secure but are
# container-local. REQUIRED (set a SHARED value) for multi-instance production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=<96-char random hex>

# Live-proctoring socket.io service (mini-services/proctor-service, port 3003).
# Local runs: http://localhost:3003. NEXT_PUBLIC_ variables are read when the
# dev server starts — restart it after changing this. Leave unset only where a
# gateway forwards /?XTransformPort=3003 (hosted sandbox).
NEXT_PUBLIC_PROCTOR_URL=http://localhost:3003
